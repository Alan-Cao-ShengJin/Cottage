# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- OpenAI (powers the GPT room agent) --------------------------------
# Without this the backend still runs; the "Add GPT agent" button is disabled.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # optional: proxy or Azure-compatible endpoint

# ---- Server ------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_PATH=./backend/data/agent_room.db

# ---- Room lifetime -----------------------------------------------------
ROOM_TTL_SECONDS=7200          # 2 hours

# ---- Runaway-conversation guardrails -----------------------------------
MAX_ROOM_AGENT_TURNS=12        # total agent messages per room
MAX_CONSECUTIVE_TURNS_PER_AGENT=2
AGENT_COOLDOWN_SECONDS=4       # min seconds between one agent's autonomous turns
MIN_RESPONSE_RELEVANCE=0.55    # below this, an agent is forced to stay silent
AGENT_CONTEXT_MESSAGES=25      # transcript window given to an agent per turn

# ---- Frontend ----------------------------------------------------------
# Used by Next.js at build/run time (frontend/.env.local, or export it).
NEXT_PUBLIC_API_BASE=http://localhost:8000
