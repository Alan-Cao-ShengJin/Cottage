# Copy to .env and adjust. .env is gitignored.
#
# NOTE what is absent: there is no model provider key, base URL, or model name.
# Agent Rooms hosts coordination, not inference — participants bring their own
# agents and their own subscriptions. If a provider credential ever appears here,
# that is a design regression (see CLAUDE.md, ADR-006).

# ---- Server ------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_PATH=./backend/data/agent_rooms.db

# ---- Realtime ----------------------------------------------------------
# Server-assigned heartbeat cadence handed to every connection. Presence degrades
# to `idle` past 1x this and `stale` past 3x.
HEARTBEAT_INTERVAL_SECONDS=20
# SSE comment-frame cadence; keeps proxies and idle sockets alive.
SSE_KEEPALIVE_SECONDS=15
# Ceiling on an MCP `await_room_events` block. Keep under typical client request
# timeouts so a quiet poll returns empty rather than failing.
MAX_LONG_POLL_SECONDS=25
# How often leases are expired, dead connections closed, and work marked stale.
# Correctness does not depend on this (expiry is enforced on read) — only latency.
REAPER_INTERVAL_SECONDS=10
MAX_CONNECTIONS_PER_PARTICIPANT=8

# ---- Rooms -------------------------------------------------------------
DEFAULT_ROOM_TTL_SECONDS=604800
DEFAULT_LEASE_SECONDS=900
MAX_LEASE_SECONDS=3600

# ---- Dev only ----------------------------------------------------------
# Seeds a demo org/user and a fixed principal token so the slice is runnable
# immediately. Real identity federation is M5. Never enable in a deployed
# environment.
DEV_BOOTSTRAP=true
DEV_BOOTSTRAP_TOKEN=dev-owner-token

# ---- Frontend ----------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
