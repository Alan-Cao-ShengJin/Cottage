# Copy to .env and adjust. .env is gitignored.
#
# NOTE what is absent: there is no model provider key, base URL, or model name.
# Agent Rooms hosts coordination, not inference — participants bring their own
# agents and their own subscriptions. If a provider credential ever appears here,
# that is a design regression (see CLAUDE.md, ADR-006).

# ---- Server ------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_PATH=./backend/data/agent_rooms.db

# ---- Realtime ----------------------------------------------------------
# Server-assigned heartbeat cadence handed to every connection. Presence degrades
# to `idle` past 1x this and `stale` past 3x.
HEARTBEAT_INTERVAL_SECONDS=20
# SSE comment-frame cadence; keeps proxies and idle sockets alive.
SSE_KEEPALIVE_SECONDS=15
# Ceiling on an MCP `await_room_events` block. Keep under typical client request
# timeouts so a quiet poll returns empty rather than failing.
MAX_LONG_POLL_SECONDS=25
# How often leases are expired, dead connections closed, and work marked stale.
# Correctness does not depend on this (expiry is enforced on read) — only latency.
REAPER_INTERVAL_SECONDS=10
MAX_CONNECTIONS_PER_PARTICIPANT=8

# ---- Rooms -------------------------------------------------------------
DEFAULT_ROOM_TTL_SECONDS=604800
DEFAULT_LEASE_SECONDS=900
MAX_LEASE_SECONDS=3600

# ---- The instance operator ---------------------------------------------
# Seeds an org, a user, and a principal token for that user. This is not dev-only:
# on a deployed instance it *is* the identity model — one operator creates rooms and
# everyone else is invited, since an invitation token is the invitee's whole
# credential. Multi-operator login is M5 (see docs/ROADMAP.md).
#
# The token below is the PUBLISHED default, so the server refuses to start when
# PUBLIC_BASE_URL is a real hostname while this is still set. Generate a real secret
# before deploying — docs/DEPLOY.md has the command.
BOOTSTRAP_OPERATOR=true
OPERATOR_TOKEN=dev-owner-token
# Who that operator is. Worth setting on a deployed instance: in a cross-company room
# the org name is one of the few fields deliberately not minimised away, so it is what
# the other side sees.
OPERATOR_ORG_NAME=Dev Org
OPERATOR_EMAIL=dev@example.com
OPERATOR_DISPLAY_NAME=Dev Owner

# ---- Room console ------------------------------------------------------
# Statically exported console, served from the same origin as the API when present.
# The container sets this; locally you normally leave it unset and run `npm run dev`.
# CONSOLE_DIR=./frontend/out

# ---- Frontend build ----------------------------------------------------
# Baked in at build time. Empty means "same origin as the page", which is what the
# container passes because one process serves both.
NEXT_PUBLIC_API_BASE=http://localhost:8000
